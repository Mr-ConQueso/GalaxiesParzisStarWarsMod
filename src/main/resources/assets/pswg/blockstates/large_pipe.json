{
  "multipart": [
    {
      "apply": {
        "model": "pswg:block/large_pipe_center"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "pswg:block/large_pipe_east"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "pswg:block/large_pipe_west"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "pswg:block/large_pipe_south"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "pswg:block/large_pipe_north"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "pswg:block/large_pipe_up"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "pswg:block/large_pipe_down"
      }
    }
  ]
}
